      "review": "Core validates exact discriminants/types/names and immutable allocation; projections/DTOs retain IDs, never indices; external fresh imports allocate new IDs, exact recovery preserves the admitted scope; readonly native consumers do not author identities."
    },
    {
      "id": "opaque",
      "fields": [
        "descriptor.extensions",
        "event.key",
        "event.value",
        "text.attributes"
      ],
      "review": "Core bounds and type-checks known keys/marks while retaining unknown inert JSON/attributes; every DTO/disabled-extension presenter preserves values; lossy HTML/Markdown exports diagnose or carry exact recovery, never drop unknowns silently."
    },
    {
      "id": "structure",
      "fields": [
        "event.tag",
        "event.tableId",
        "event.lamport",
        "event.ownerId",
        "event.axisId",
        "event.leftId",
        "event.rightId",
        "event.rowId",
        "event.columnId",
        "event.blockId",
        "event.style",
        "event.scope"
      ],
      "review": "Core validates arity/references/causality and deterministic replay; DTOs carry stable targets and exact retained records; presenters consume derived order/style/geometry, no repair; formats map only explicitly representable structure and retain the remainder in recovery."
    },
    {
      "id": "source",
      "fields": [
        "event.basis",
        "event.dialect",
        "event.bytes"
      ],
      "review": "Core validates source provenance and budgets without treating source as live content; bridge prepare_table_source and Markdown reconciliation compare basis/revision, preserve stale snapshots and original bytes; projections/native ports expose source validity, not stale editable rows."
    },
    {
      "id": "history",
      "fields": [
        "event.targetEventId",
        "event.enabled",
        "text.items"
      ],
      "review": "Core retains IDs/items/disabled events and scopes selective local undo; Session persistence/FFI/WASM exact export preserves this state and fresh-writer provenance; visible/native/HTML/Markdown projections cannot replace it with a rows matrix."
    },
    {
      "id": "derived",
      "fields": [
        "projection.revision",
        "projection.conflicts"
      ],
      "review": "Core computes scoped revisions and retained-conflict references; Session/WASM/FFI transport them; web/native/terminal use them for target validation/accessibility, formats report hidden/lossy content; these are derived, never another writable CRDT."
    }
  ]
