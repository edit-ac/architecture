test('duplicate names and unsafe extension output recover source with zero effects',()=>probe('rejection',async(page,fact)=>{const r=await page.evaluate(()=>{const f=window.inputFixture,before=Array.from(f.engine.checkpoint().bytes),errors=[];for(const options of [{extensions:[{name:'same'},{name:'same'}]},{extensions:[{name:'unsafe',prepare:()=>[{attributes:{type:'paragraph'},runs:[{text:'bad',marks:[{mark:'link',href:'javascript:alert(1)'}]}]}]}]){try{f.engine.importMarkdown('source',options);}catch(e){errors.push(e.message);}}return {before,after:Array.from(f.engine.checkpoint().bytes),errors};});assert.deepEqual(r.before,r.after);assert.equal(r.errors.length,2);assert.equal((await state(page,fact)).journal.length,0);}));
                                                                                                                                                                                                                                                                                                                                                                                                                                                                    ^
test('disabled callout and false custom serialization have explicit recovery',()=>probe('recovery',async(page,fact)=>{const r=await page.evaluate(()=>{const f=window.inputFixture,p=f.engine.importMarkdown('> [!NOTE]\n> body'),e=f.engine.exportMarkdown(f.engine.importMarkdown('**safe**').blocks,{extensions:[{name:'wrong',serialize:()=> 'lost'}]});return {p,e};});assert.ok(r.p.diagnostics.some(d=>d.code==='callout-codec-disabled'));assert.equal(r.e.diagnostics[0].code,'extension-unrepresentable');assert.ok(r.e.recovery.length);assert.equal((await state(page,fact)).journal.length,0);}));

