  "acceptance": {
    "receiptOnlyAfterCommit": "Paused precommit operation has no receipt and independent read connection sees zero rows; commit exception rolls back; after-commit/before-receipt process kills persist byte identity with no delivered receipt.",
    "restartReplay": "Real child restart restores transactionally committed bytes; actual Rust and Yjs semantic snapshots converge after shuffled duplicate replay.",
    "duplicateIdempotence": "Unique document/epoch/writer/sequence and exact content identity return stable stored cursor/receipt; conflicting reuse rejected.",
    "noProductionAuthClaim": "Loopback enforced; prepared grants only; receipt capability is explicitly negotiated and absent capability reports unknown. No deployment or client-outbox integration claim."
  },
