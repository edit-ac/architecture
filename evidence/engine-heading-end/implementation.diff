+    e.history({ type: 'undo' }); assert.deepEqual(headingNodes(e).map(headingText), ['H😀Z', 'remove', 'peer']);
+    e.history({ type: 'redo' }); assert.deepEqual(headingNodes(e).map(headingText), ['H', '', 'peer']);
