{
  "name": "@edit-ac/architecture",
  "version": "0.0.0",
  "private": true,
  "description": "Architecture and deterministic development-roadmap checks for Edit-ac.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:roadmaps": "node scripts/validate-roadmaps.mjs",
    "check": "npm run validate:roadmaps && npm run validate:editing-suite && npm run test:editing-suite-contract && npm run test:runner-guard && npm run test:execution-queue",
    "test:runner-guard": "python3 -m unittest discover -s tests -p test_roadmap_recovery_guard.py",
    "validate:editing-suite": "node scripts/validate-editing-suite.mjs",
    "test:editing-suite-contract": "node --test tests/editing-suite-contract.test.mjs",
    "validate:execution-queue": "python3 scripts/validate-execution-queue.py",
    "test:execution-queue": "python3 -m unittest discover -s tests -p test_execution_queue.py"
  },
  "devDependencies": {
    "@bpstr/roadmap-runner": "0.8.0"
  },
  "license": "Apache-2.0",
  "packageManager": "npm@11.17.0"
}
