{
  "schemaVersion": 1,
  "id": "SEQ-09",
  "layer": "semantic",
  "covers": [
    "PST-06",
    "HIS-04"
  ],
  "requires": [
    "async-anchors",
    "remote-delete",
    "session-isolation"
  ],
  "context": {
    "document": "doc-a",
    "editor": "editor-a",
    "epoch": 1
  },
  "initial": {
    "blocks": [
      {
        "id": "p1",
        "kind": "paragraph",
        "text": "target",
        "hardBreaks": [],
        "marks": []
      },
      {
        "id": "p2",
        "kind": "paragraph",
        "text": "other",
        "hardBreaks": [],
        "marks": []
      }
    ],
    "selection": {
      "anchor": {
        "block": "p1",
        "offset": 2
      },
      "focus": {
        "block": "p1",
        "offset": 2
      },
      "affinity": "forward"
    },
    "pendingMarks": null
  },
  "steps": [
    {
      "id": "begin",
      "action": {
        "type": "beginPaste",
        "request": "paste-1",
        "text": "X"
      },
      "expect": {
        "outcome": "staged",
        "state": {
          "blocks": [
            {
              "id": "p1",
              "kind": "paragraph",
              "text": "target",
              "hardBreaks": [],
              "marks": []
            },
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "other",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p1",
              "offset": 2
            },
            "focus": {
              "block": "p1",
              "offset": 2
            },
            "affinity": "forward"
          },
          "pendingMarks": null
        },
        "effects": {
          "localCommits": 0,
          "remoteCommits": 0
        }
      }
    },
    {
      "id": "remote",
      "action": {
        "type": "remoteDeleteBlock",
        "block": "p1"
      },
      "expect": {
        "outcome": "applied",
        "state": {
          "blocks": [
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "other",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p2",
              "offset": 0
            },
            "focus": {
              "block": "p2",
              "offset": 0
            },
            "affinity": "forward"
          },
          "pendingMarks": null
        },
        "effects": {
          "localCommits": 0,
          "remoteCommits": 1
        }
      }
    },
    {
      "id": "stale-completion",
      "action": {
        "type": "completePaste",
        "request": "paste-1"
      },
      "expect": {
        "outcome": "rejected",
        "state": {
          "blocks": [
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "other",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p2",
              "offset": 0
            },
            "focus": {
              "block": "p2",
              "offset": 0
            },
            "affinity": "forward"
          },
          "pendingMarks": null
        },
        "effects": {
          "localCommits": 0,
          "remoteCommits": 0
        }
      }
    }
  ]
}
