{
  "schemaVersion": 1,
  "id": "SEQ-05",
  "layer": "semantic",
  "covers": [
    "MRK-03",
    "REG-05"
  ],
  "requires": [
    "pending-marks",
    "compound-edit"
  ],
  "context": {
    "document": "doc-a",
    "editor": "editor-a",
    "epoch": 1
  },
  "initial": {
    "blocks": [
      {
        "id": "p1",
        "kind": "paragraph",
        "text": "",
        "hardBreaks": [],
        "marks": []
      },
      {
        "id": "p2",
        "kind": "paragraph",
        "text": "plain",
        "hardBreaks": [],
        "marks": []
      }
    ],
    "selection": {
      "anchor": {
        "block": "p1",
        "offset": 0
      },
      "focus": {
        "block": "p1",
        "offset": 0
      },
      "affinity": "forward"
    },
    "pendingMarks": null
  },
  "steps": [
    {
      "id": "toggle",
      "action": {
        "type": "toggleMark",
        "mark": "bold"
      },
      "expect": {
        "outcome": "selection-only",
        "state": {
          "blocks": [
            {
              "id": "p1",
              "kind": "paragraph",
              "text": "",
              "hardBreaks": [],
              "marks": []
            },
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "plain",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p1",
              "offset": 0
            },
            "focus": {
              "block": "p1",
              "offset": 0
            },
            "affinity": "forward"
          },
          "pendingMarks": [
            "bold"
          ]
        },
        "effects": {
          "localCommits": 0,
          "remoteCommits": 0
        }
      }
    },
    {
      "id": "type",
      "action": {
        "type": "insertText",
        "text": "X"
      },
      "expect": {
        "outcome": "applied",
        "state": {
          "blocks": [
            {
              "id": "p1",
              "kind": "paragraph",
              "text": "X",
              "hardBreaks": [],
              "marks": [
                {
                  "from": 0,
                  "to": 1,
                  "type": "bold"
                }
              ]
            },
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "plain",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p1",
              "offset": 1
            },
            "focus": {
              "block": "p1",
              "offset": 1
            },
            "affinity": "forward"
          },
          "pendingMarks": [
            "bold"
          ]
        },
        "effects": {
          "localCommits": 1,
          "remoteCommits": 0
        }
      }
    },
    {
      "id": "move",
      "action": {
        "type": "setSelection",
        "selection": {
          "anchor": {
            "block": "p2",
            "offset": 5
          },
          "focus": {
            "block": "p2",
            "offset": 5
          },
          "affinity": "forward"
        }
      },
      "expect": {
        "outcome": "selection-only",
        "state": {
          "blocks": [
            {
              "id": "p1",
              "kind": "paragraph",
              "text": "X",
              "hardBreaks": [],
              "marks": [
                {
                  "from": 0,
                  "to": 1,
                  "type": "bold"
                }
              ]
            },
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "plain",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p2",
              "offset": 5
            },
            "focus": {
              "block": "p2",
              "offset": 5
            },
            "affinity": "forward"
          },
          "pendingMarks": null
        },
        "effects": {
          "localCommits": 0,
          "remoteCommits": 0
        }
      }
    },
    {
      "id": "plain-sentinel",
      "action": {
        "type": "insertText",
        "text": "!"
      },
      "expect": {
        "outcome": "applied",
        "state": {
          "blocks": [
            {
              "id": "p1",
              "kind": "paragraph",
              "text": "X",
              "hardBreaks": [],
              "marks": [
                {
                  "from": 0,
                  "to": 1,
                  "type": "bold"
                }
              ]
            },
            {
              "id": "p2",
              "kind": "paragraph",
              "text": "plain!",
              "hardBreaks": [],
              "marks": []
            }
          ],
          "selection": {
            "anchor": {
              "block": "p2",
              "offset": 6
            },
            "focus": {
              "block": "p2",
              "offset": 6
            },
            "affinity": "forward"
          },
          "pendingMarks": null
        },
        "effects": {
          "localCommits": 1,
          "remoteCommits": 0
        }
      }
    }
  ]
}
