{
    "name": "edit-ac/php-toolchain-bootstrap",
    "description": "Framework-free local PHP toolchain probe, not the editor SDK",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "8.5.4",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "psr/log": "3.0.2"
    },
    "autoload": {
        "psr-4": { "EditAc\\Toolchain\\": "src/" }
    },
    "config": {
        "allow-plugins": false,
        "platform": { "php": "8.5.4" },
        "sort-packages": true
    }
}
